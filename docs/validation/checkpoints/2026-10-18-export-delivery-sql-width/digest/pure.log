mkdir -p build/data-tests
clang -Isrc -O2 -g -std=c99 -Wall -Wextra -Wpedantic -Werror src/data/source_digest.c tests/test_source_digest.c -o build/data-tests/test-source-digest
mkdir -p build/data-tests
clang -Isrc -O1 -g -std=c99 -Wall -Wextra -Wpedantic -Werror -fsanitize=address,undefined -fno-omit-frame-pointer src/data/source_digest.c tests/test_source_digest.c -o build/data-tests/test-source-digest-sanitize
mkdir -p build/data-tests
clang -Isrc -O2 -g -std=c99 -Wall -Wextra -Wpedantic -Werror -D__EMSCRIPTEN__ src/data/source_digest.c tests/test_source_digest.c -o build/data-tests/test-source-digest-unsupported
./build/data-tests/test-source-digest
PASS source-digest: 4429 checks
ASAN_OPTIONS=halt_on_error=1 ./build/data-tests/test-source-digest-sanitize
