    "cfd9e2510fbb315bc659b232fb27f141a86624fd9d1191f83520ed9c3f05e531": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(position AS VARCHAR) AS position,CAST(name AS VARCHAR) AS name,CAST(descending AS VARCHAR) AS descending FROM (SELECT * FROM ((SELECT sheet_id,position,name,descending FROM _duxcel_workspace.sorts ORDER BY sheet_id,position LIMIT 449) UNION ALL SELECT 63::INTEGER AS sheet_id,7::INTEGER AS position,'sentinel'::VARCHAR AS name,false::BOOLEAN AS descending) AS _codec_sorts_sentinel ORDER BY sheet_id,position LIMIT 449) AS _codec_sorts_projection"
