    "de0b860fb04f55a3c8e0d5296bb0daf99abb1752b421eb6a0836285f622642e9": "SELECT CAST(\"id\" AS VARCHAR) AS \"id\",CAST(\"name\" AS VARCHAR) AS \"name\",CAST(\"kind\" AS VARCHAR) AS \"kind\",CAST(\"path\" AS VARCHAR) AS \"path\",CAST(\"source_schema\" AS VARCHAR) AS \"source_schema\",CAST(\"source_table\" AS VARCHAR) AS \"source_table\",CAST(\"filter_column\" AS VARCHAR) AS \"filter_column\",CAST(\"filter_value\" AS VARCHAR) AS \"filter_value\",CAST(\"filter_op\" AS VARCHAR) AS \"filter_op\",CAST(\"group_column\" AS VARCHAR) AS \"group_column\",CAST(\"measure_column\" AS VARCHAR) AS \"measure_column\",CAST(\"aggregate\" AS VARCHAR) AS \"aggregate\",CAST(\"sort_column\" AS VARCHAR) AS \"sort_column\",CAST(\"descending\" AS VARCHAR) AS \"descending\",CAST(\"active_row\" AS VARCHAR) AS \"active_row\",CAST(\"active_col\" AS VARCHAR) AS \"active_col\",CAST(\"anchor_row\" AS VARCHAR) AS \"anchor_row\",CAST(\"anchor_col\" AS VARCHAR) AS \"anchor_col\",CAST(\"end_row\" AS VARCHAR) AS \"end_row\",CAST(\"end_col\" AS VARCHAR) AS \"end_col\",CAST(\"top_row\" AS VARCHAR) AS \"top_row\",CAST(\"horizontal\" AS VARCHAR) AS \"horizontal\",CAST(\"fraction\" AS VARCHAR) AS \"fraction\",CAST(\"selection\" AS VARCHAR) AS \"selection\",CAST(\"canvas_zoom\" AS VARCHAR) AS \"canvas_zoom\" FROM (SELECT id,name,kind,path,source_schema,source_table,filter_column,filter_value,filter_op,group_column,measure_column,aggregate,sort_column,descending,active_row,active_col,anchor_row,anchor_col,end_row,end_col,top_row,horizontal,fraction,selection,canvas_zoom AS canvas_zoom FROM _duxcel_workspace.sheets ORDER BY id LIMIT 65) AS _duxcel_relation LIMIT 256 OFFSET 0",
    "82f503d59f5829ff70058f7ebb879daa4b5fbcd6e83e5666a3ced665c126a185": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(position AS VARCHAR) AS position,CAST(name AS VARCHAR) AS name,CAST(descending AS VARCHAR) AS descending FROM (SELECT sheet_id,position,name,descending FROM _duxcel_workspace.sorts ORDER BY sheet_id,position LIMIT 449) AS _codec_sorts_projection",
