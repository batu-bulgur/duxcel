    "e960b58f0c7fccd12a33554e545ab715428026143cd61c54408b457f32d95322": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(position AS VARCHAR) AS position,CAST(name AS VARCHAR) AS name,CAST(descending AS VARCHAR) AS descending FROM (SELECT * FROM (SELECT sheet_id,position,name,descending FROM _duxcel_workspace.sorts ORDER BY sheet_id,position LIMIT 449) AS _codec_sorts_reverse ORDER BY sheet_id DESC,position) AS _codec_sorts_projection",
