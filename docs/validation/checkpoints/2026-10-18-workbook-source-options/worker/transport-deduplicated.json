    "3cc46e61c501e828148169c743bd79d255662239622c1fa6bbbe977b47dc465f": "SELECT CAST(\"version\" AS VARCHAR) AS \"version\",CAST(\"active_sheet\" AS VARCHAR) AS \"active_sheet\",CAST(\"user_scale\" AS VARCHAR) AS \"user_scale\" FROM (SELECT version,active_sheet,user_scale FROM _duxcel_workspace.meta LIMIT 2) AS _duxcel_relation LIMIT 256 OFFSET 0",
    "de0b860fb04f55a3c8e0d5296bb0daf99abb1752b421eb6a0836285f622642e9": "SELECT CAST(\"id\" AS VARCHAR) AS \"id\",CAST(\"name\" AS VARCHAR) AS \"name\",CAST(\"kind\" AS VARCHAR) AS \"kind\",CAST(\"path\" AS VARCHAR) AS \"path\",CAST(\"source_schema\" AS VARCHAR) AS \"source_schema\",CAST(\"source_table\" AS VARCHAR) AS \"source_table\",CAST(\"filter_column\" AS VARCHAR) AS \"filter_column\",CAST(\"filter_value\" AS VARCHAR) AS \"filter_value\",CAST(\"filter_op\" AS VARCHAR) AS \"filter_op\",CAST(\"group_column\" AS VARCHAR) AS \"group_column\",CAST(\"measure_column\" AS VARCHAR) AS \"measure_column\",CAST(\"aggregate\" AS VARCHAR) AS \"aggregate\",CAST(\"sort_column\" AS VARCHAR) AS \"sort_column\",CAST(\"descending\" AS VARCHAR) AS \"descending\",CAST(\"active_row\" AS VARCHAR) AS \"active_row\",CAST(\"active_col\" AS VARCHAR) AS \"active_col\",CAST(\"anchor_row\" AS VARCHAR) AS \"anchor_row\",CAST(\"anchor_col\" AS VARCHAR) AS \"anchor_col\",CAST(\"end_row\" AS VARCHAR) AS \"end_row\",CAST(\"end_col\" AS VARCHAR) AS \"end_col\",CAST(\"top_row\" AS VARCHAR) AS \"top_row\",CAST(\"horizontal\" AS VARCHAR) AS \"horizontal\",CAST(\"fraction\" AS VARCHAR) AS \"fraction\",CAST(\"selection\" AS VARCHAR) AS \"selection\",CAST(\"canvas_zoom\" AS VARCHAR) AS \"canvas_zoom\" FROM (SELECT id,name,kind,path,source_schema,source_table,filter_column,filter_value,filter_op,group_column,measure_column,aggregate,sort_column,descending,active_row,active_col,anchor_row,anchor_col,end_row,end_col,top_row,horizontal,fraction,selection,canvas_zoom AS canvas_zoom FROM _duxcel_workspace.sheets ORDER BY id LIMIT 65) AS _duxcel_relation LIMIT 256 OFFSET 0",
    "be18f6d11a443085a787328f61053a71786d7bede6911cfe9d364a04a851100a": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(id AS VARCHAR) AS id,CAST(name AS VARCHAR) AS name,CAST(row_id AS VARCHAR) AS row_id,CAST(column_id AS VARCHAR) AS column_id,CAST(height AS VARCHAR) AS height,CAST(width AS VARCHAR) AS width,CAST(kind AS VARCHAR) AS kind,CAST(mark AS VARCHAR) AS mark,CAST(source_id AS VARCHAR) AS source_id,CAST(chart_measure AS VARCHAR) AS chart_measure FROM (SELECT sheet_id,id,name,row_id,column_id,height,width,kind,mark,source_id,chart_measure FROM _duxcel_workspace.objects ORDER BY sheet_id,id LIMIT 2049) AS _options_objects_projection",
    "fdf8ad1814af68c70c3214edba7a0cc55c554c1c1f42960df138a51d54d0464d": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(object_id AS VARCHAR) AS object_id,CAST(unique_rows AS VARCHAR) AS unique_rows FROM (SELECT sheet_id,object_id,unique_rows FROM _duxcel_workspace.source_options ORDER BY sheet_id,object_id LIMIT 2113) AS _options_projection",
    "d68af27f66aa9a2b058d64708e864df94484eb910a5886cd0a3d35a8b5d5cb8a": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(object_id AS VARCHAR) AS object_id,CAST(query AS VARCHAR) AS query FROM (SELECT sheet_id,object_id,CASE WHEN query IS NULL OR octet_length(encode(query))>65536 OR length(trim(query))=0 OR contains(query,chr(0)) THEN NULL::VARCHAR ELSE query END AS query FROM _duxcel_workspace.queries ORDER BY sheet_id,object_id LIMIT 2113) AS _options_query_projection",
    "30864c836a3cafcf340464450a093fa3e2dc0d6e89dfa67d51a6c44d3d66934e": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(object_id AS VARCHAR) AS object_id,CAST(unique_rows AS VARCHAR) AS unique_rows FROM (SELECT * REPLACE (CASE WHEN sheet_id=63 AND object_id=18446744073709551615::UBIGINT THEN NULL::BOOLEAN ELSE unique_rows END AS unique_rows) FROM (SELECT sheet_id,object_id,unique_rows FROM _duxcel_workspace.source_options ORDER BY sheet_id,object_id LIMIT 2113) AS _options_null) AS _options_projection",
    "5f54fa75a7e71e584f69954de08ab5389f9e94882fb52715f9abd96fd618dfc5": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(object_id AS VARCHAR) AS object_id,CAST(unique_rows AS VARCHAR) AS unique_rows FROM (SELECT * REPLACE (CASE WHEN sheet_id=0 AND object_id=9007199254740993::UBIGINT THEN 0::UBIGINT ELSE object_id END AS object_id,CASE WHEN sheet_id=0 AND object_id IN (0::UBIGINT,9007199254740993::UBIGINT) THEN false ELSE unique_rows END AS unique_rows) FROM (SELECT sheet_id,object_id,unique_rows FROM _duxcel_workspace.source_options ORDER BY sheet_id,object_id LIMIT 2113) AS _options_duplicate_false ORDER BY sheet_id,object_id) AS _options_projection",
    "faef14f7e0b9936a957f9e4d34c8c8dc09ab7dde84f316233e06f940196cf90d": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(id AS VARCHAR) AS id,CAST(name AS VARCHAR) AS name,CAST(row_id AS VARCHAR) AS row_id,CAST(column_id AS VARCHAR) AS column_id,CAST(height AS VARCHAR) AS height,CAST(width AS VARCHAR) AS width,CAST(kind AS VARCHAR) AS kind,CAST(mark AS VARCHAR) AS mark,CAST(source_id AS VARCHAR) AS source_id,CAST(chart_measure AS VARCHAR) AS chart_measure FROM (SELECT * REPLACE (CASE WHEN sheet_id=0 AND id=9007199254740993::UBIGINT THEN 0::INTEGER ELSE kind END AS kind) FROM (SELECT sheet_id,id,name,row_id,column_id,height,width,kind,mark,source_id,chart_measure FROM _duxcel_workspace.objects ORDER BY sheet_id,id LIMIT 2049) AS _options_wrong_kind) AS _options_objects_projection",
    "fd6413669766f982130ff6d16241066eaa01da615ec9dffbc5a4607e205c83a1": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(object_id AS VARCHAR) AS object_id,CAST(unique_rows AS VARCHAR) AS unique_rows FROM (SELECT * REPLACE (CASE WHEN sheet_id=0 AND object_id=9007199254740993::UBIGINT THEN 18446744073709551615::UBIGINT ELSE object_id END AS object_id) FROM (SELECT sheet_id,object_id,unique_rows FROM _duxcel_workspace.source_options ORDER BY sheet_id,object_id LIMIT 2113) AS _options_foreign ORDER BY sheet_id,object_id) AS _options_projection",
    "44bdf1131246be1f0861ebaf9e0fe370148a0c2a7c4e577151aa1e1a3c063d55": "SELECT CAST(sheet_id AS VARCHAR) AS sheet_id,CAST(object_id AS VARCHAR) AS object_id,CAST(unique_rows AS VARCHAR) AS unique_rows FROM (SELECT * FROM ((SELECT sheet_id,object_id,unique_rows FROM _duxcel_workspace.source_options ORDER BY sheet_id,object_id LIMIT 2113) UNION ALL SELECT 64::INTEGER AS sheet_id,0::UBIGINT AS object_id,true AS unique_rows) AS _options_sentinel ORDER BY sheet_id,object_id LIMIT 2113) AS _options_projection",
